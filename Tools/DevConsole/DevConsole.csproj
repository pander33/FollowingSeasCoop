<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Development-only BepInEx plugin: a loopback HTTP endpoint that runs compiled C# snippets inside the running game.
    Builds into its OWN plugin folder so it is never packed with FollowingSeasCoop. Never ship it.
    See README.md next to this file.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>FollowingSeasCoopDevConsole</AssemblyName>
    <RootNamespace>FollowingSeasCoop.DevConsole</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>

    <GameDir Condition="'$(GameDir)'==''">B:\FollowingSeasModTest</GameDir>
    <ManagedDir>$(GameDir)\Following Seas_Data\Managed</ManagedDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <OutputPath>$(GameDir)\BepInEx\plugins\FollowingSeasCoopDevConsole\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
